# Copy to .env (git-ignored) and fill in; keep it owner-only (chmod 600 .env). Never commit a key.
# Meshy API key for tools/meshy_generate.py (maintainers only; generation is never part of a tile build).
# Create one at https://www.meshy.ai/settings/api (the API needs a paid Meshy plan).
MESHY_API_KEY=
# Native Land Digital API key for pipeline/fetch_territories.py (the territories under a tile's place name on the start screen).
# Free: sign up at https://native-land.ca (API docs: https://api-docs.native-land.ca). Their map does not represent official or legal boundaries.
# Either name works (NATIVE_LAND_KEY is read first, then NATIVE_LAND_API_KEY).
NATIVE_LAND_KEY=

# The hosted hub (docs/hosting.md): the public origin the browser sees (the cookie and the Discord redirect use it).
HUB_ORIGIN=https://example.com
# deploy/docker-compose.yml only: the domain Caddy gets a certificate for.
HUB_DOMAIN=example.com
# Discord sign-in (docs/multiplayer.md): the application's id and secret from the Discord developer portal, with the
# redirect set to <HUB_ORIGIN>/api/hub/oauth/discord. Absent: the button is greyed.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
