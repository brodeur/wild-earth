# Copy to .env (git-ignored) and fill in; keep it owner-only (chmod 600 .env). Never commit a key.
# Meshy API key for tools/meshy_generate.py (maintainers only; generation is never part of a tile build).
# Create one at https://www.meshy.ai/settings/api (the API needs a paid Meshy plan).
MESHY_API_KEY=
# Native Land Digital API key for pipeline/fetch_territories.py (the territories under a tile's place name on the start screen).
# Free: sign up at https://native-land.ca (API docs: https://api-docs.native-land.ca). Their map does not represent official or legal boundaries.
NATIVE_LAND_KEY=
