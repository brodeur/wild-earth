 "fine_tunes": {
  "bison_bison": {
   "tile": "utm12n_557_4964",
   "source": "NPS summer aerial counts of the northern Yellowstone bison: 3,667 in 2019 (Geremia et al. 2019, Status Report on the Yellowstone Bison Population), 3,819 in 2023 (2023 Bison Population Status Report); the northern bison congregate in the Lamar Valley and on the adjacent plateaus for the rut, mid-July to mid-August (NPS Yellowstone Bison executive summary)",
   "reduction": "summer: about 3,700 bison over a Lamar Valley and Mirror Plateau summer range of some 600 km2, about 6 per km2; the other seasons lower as the northern bison move down the Lamar to the Blacktail and Gardiner basins for the winter and come back through spring. A modelling reduction, not a count on this tile",
   "species": {
    "rut": [
     7,
     8
    ],
    "reason": "the rut is mid-July to mid-August; the bulls join the cow groups then and leave them in bachelor bands for the rest of the year",
    "source": "NPS Yellowstone Bison executive summary (https://www.nps.gov/yell/learn/nature/upload/YellowstoneBison_ExecutiveSummary.pdf)"
   }
  },
  "ovis_canadensis": {
   "species": {
    "terrain": "steep",
    "reason": "bighorn sheep stay within a few hundred metres of escape terrain (cliffs, steep broken slopes) and do not gather on valley floors; the general rule's flat, low ground is inverted for them",
    "source": "Geist, V. (1971). Mountain Sheep: A Study in Behavior and Evolution. University of Chicago Press; Smith, Flinders and Winn (1991), Great Basin Naturalist 51: 205-225 (escape terrain within 300 m)"
   }
  },
  "cervus_canadensis": {
   "tile": "utm12n_557_4964",
   "source": "Northern Yellowstone Cooperative Wildlife Working Group / Montana FWP helicopter count, April 2025: 7,226 elk in the northern Yellowstone herd, 1,102 of them inside the park (NPS 2025 Wolf, Cougar and Elk Project annual report)",
   "reduction": "winter: about 1,100 elk on the park's share of the northern winter range, of which the Lamar Valley is a core part, about 2.5 per km2; most move to higher summer ranges, so summer is the lowest. A modelling reduction, not a count on this tile",
   "species": {
    "rut": [
     9,
     10
    ],
    "reason": "the elk rut is September and October: a herd bull holds a harem in the cow herd",
    "source": "Clutton-Brock, Guinness and Albon (1982). Red Deer: Behavior and Ecology of Two Sexes. University of Chicago Press"
   }
  },
  "odocoileus_hemionus": {
