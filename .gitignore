.venv/
__pycache__/
*.pyc
# Large rasters are regenerated by the pipeline; keep the manifest and vector layers.
tiles/**/*.tif
tiles/**/*.png
tiles/**/*.jpg
tiles/**/_cache/
.DS_Store
.claude/worktrees/
pipeline/_cache/

# Local secrets (API keys): never committed. Copy .env.example if one exists.
.env
.env.*
!.env.example

# Played game worlds (per tile and season, written by the game server)
tiles/**/game/

# Lidar crown lists are regenerated by the lidar step like the rasters
tiles/**/*.bin

# The San Francisco cells' OSM building footprints (every building in the city: 99 MB and 45 MB);
# regenerated by the osm step like the rasters. The foothill tiles' masks (under 5 MB) stay tracked.
tiles/utm10n_540_4170/footprint/mask.geojson
tiles/utm10n_540_4180/footprint/mask.geojson
